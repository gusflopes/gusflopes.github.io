---
import { getCollection } from 'astro:content';
import Default from '../layouts/Default.astro';
import { InsightsPage, type InsightArticle } from '../components/pages/InsightsPage';
import { compareIsoDateDesc, formatDatePtBR } from '../lib/format';

const entries = await getCollection('insights');
const articles: InsightArticle[] = entries
  .sort((a, b) => compareIsoDateDesc(a.data.date, b.data.date))
  .map((entry) => ({
    id: entry.id,
    ...entry.data,
    date: formatDatePtBR(entry.data.date),
  }));
---

<Default
  title="Insights"
  description="Artigos técnicos sobre arquitetura profunda, filosofia de código e engenharia de software."
>
  <InsightsPage articles={articles} client:load />
</Default>
